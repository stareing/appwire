{
  "name": "@app-mcp/store",
  "version": "0.1.0",
  "description": "AppWire state store adapter: expose Zustand, Redux and Pinia actions as MCP tools and state as resources",
  "keywords": ["zustand", "redux", "pinia", "state-management", "mcp", "model-context-protocol", "mcp-server", "ai", "ai-agent", "llm", "tool-calling", "function-calling", "claude", "openai", "gemini", "appwire"],
  "homepage": "https://github.com/stareing/appwire/tree/main/packages/store#readme",
  "repository": { "type": "git", "url": "git+https://github.com/stareing/appwire.git", "directory": "packages/store" },
  "bugs": { "url": "https://github.com/stareing/appwire/issues" },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./zustand": { "types": "./dist/zustand.d.ts", "import": "./dist/zustand.js" },
    "./redux": { "types": "./dist/redux.d.ts", "import": "./dist/redux.js" },
    "./pinia": { "types": "./dist/pinia.d.ts", "import": "./dist/pinia.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@app-mcp/web": "workspace:*"
  },
  "devDependencies": {
    "zustand": "^5.0.0",
    "@reduxjs/toolkit": "^2.0.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "zod": "^4.6.5",
    "happy-dom": "^20.14.5"
  }
}
