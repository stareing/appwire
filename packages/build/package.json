{
  "name": "@app-mcp/build",
  "version": "0.1.0",
  "description": "AppWire build plugin (Vite): generate MCP tools and the app-mcp.json manifest from @mcp doc comments",
  "keywords": ["vite", "vite-plugin", "codegen", "manifest", "mcp", "model-context-protocol", "mcp-server", "ai", "ai-agent", "llm", "tool-calling", "function-calling", "claude", "openai", "gemini", "appwire"],
  "homepage": "https://github.com/stareing/appwire/tree/main/packages/build#readme",
  "repository": { "type": "git", "url": "git+https://github.com/stareing/appwire.git", "directory": "packages/build" },
  "bugs": { "url": "https://github.com/stareing/appwire/issues" },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@app-mcp/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "@app-mcp/source": "./src/define.ts",
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./annotations": {
      "@app-mcp/source": "./src/annotations.ts",
      "types": "./dist/annotations.d.ts",
      "import": "./dist/annotations.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@app-mcp/web": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "vite": "^8.3.1",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
