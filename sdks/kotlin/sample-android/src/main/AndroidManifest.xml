<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SampleApp"
        android:label="app-mcp 示例"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Compose 导航示例（第 4c 项）：导航回调会从后台把它切到前台（am start -n …/.NavActivity 也可直接打开） -->
        <activity
            android:name=".NavActivity"
            android:exported="true" />

        <!--
          按名寻址（spec/naming.md 4.2）：SDK 的 ToolsService 经清单合并加入；这里补上静态清单，设备上的 Hub（如
          hub-app-android）只读这项元数据发现本 App，调用时 bindService 即激活本进程。release 与 Hub App 都用 debug
          keystore 签名，同证书即可信（HubTrust）。
        -->
        <service android:name="dev.appmcp.android.ToolsService">
            <meta-data
                android:name="dev.appmcp.manifest"
                android:resource="@raw/app_mcp" />
        </service>
    </application>
</manifest>
