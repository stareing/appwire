<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AppMcp</RootNamespace>
    <AssemblyName>AppMcp</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 公开成员缺少 XML 注释时不报错 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>AppWire C# SDK: expose WPF, WinUI and .NET app actions as MCP (Model Context Protocol) tools for AI agents</Description>
    <PackageTags>mcp;model-context-protocol;ai-agent;llm;tool-calling;wpf;winui;appwire</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AppMcp.Tests" />
    <!-- 控件兜底的大纲格式（UiFallback/）由各 UI 框架绑定共用 -->
    <InternalsVisibleTo Include="AppMcp.Wpf" />
    <InternalsVisibleTo Include="AppMcp.Wpf.Tests" />
    <InternalsVisibleTo Include="AppMcp.WinUI" />
  </ItemGroup>

</Project>
