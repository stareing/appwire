<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AppMcp</RootNamespace>
    <AssemblyName>AppMcp</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 公开成员缺少 XML 注释时不报错 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>app-mcp 的 C# SDK（基于 C ABI 的 P/Invoke 封装）</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AppMcp.Tests" />
  </ItemGroup>

</Project>
