<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AppMcp.Hub</RootNamespace>
    <AssemblyName>AppMcp.Hub</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 公开成员缺少 XML 注释时不报错 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>AppWire Hub for .NET: embed the hub in a C# agent to call the MCP tools of every app on the device</Description>
    <PackageTags>mcp;model-context-protocol;ai-agent;llm;tool-calling;agent;appwire</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AppMcp.Hub.Tests" />
  </ItemGroup>

</Project>
