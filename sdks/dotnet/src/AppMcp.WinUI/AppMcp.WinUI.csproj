<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WinUI 3 绑定（第 4c 项 E）：view 工具随控件加载 / Visibility / 窗口激活启用、Frame 导航适配；
    控件兜底（第 4c 项 H，UiFallback/）：经 AutomationPeer 的 ui.outline / click / fill / press / scroll / read。
    只能在 Windows 上构建（需要 Microsoft.WindowsAppSDK）；不在 AppMcp.sln 中。
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- @why 纯代码库，没有 XAML / 资源：不生成 PRI（dotnet CLI 缺少 VS 的 PRI 打包任务时也能构建）。 -->
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <RootNamespace>AppMcp.WinUI</RootNamespace>
    <AssemblyName>AppMcp.WinUI</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>AppWire WinUI 3 bindings: enable view-surface MCP tools while their element is loaded, visible and its window is active; Frame navigation adapter; opt-in in-process control fallback (ui.outline / click / fill) via AutomationPeer</Description>
    <PackageTags>mcp;model-context-protocol;ai-agent;winui;appwire</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AppMcp/AppMcp.csproj" />
  </ItemGroup>

</Project>
