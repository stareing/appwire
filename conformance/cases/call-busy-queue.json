{
  "id": "call-busy-queue",
  "title": "用户正在操作（busy）且策略为 queue：写调用排队、不阻塞其后的只读调用；取消 busy 后按到达顺序执行",
  "spec": ["protocol.md 5.3"],
  "requires": ["busy"],
  "app": {
    "busy": true,
    "config": { "busyPolicy": "queue" },
    "tools": [
      { "name": "b.edit", "description": "写操作", "risk": "write", "handler": { "counter": true } },
      { "name": "b.done", "description": "用户停手", "risk": "read", "handler": { "delayMs": 200, "mutate": [{ "op": "busy", "value": false }], "return": { "ok": true } } }
    ]
  },
  "host": { "timeoutMs": 15000, "ops": [
    { "invoke": "b.edit", "noWait": true },
    { "invoke": "b.edit", "noWait": true },
    { "invoke": "b.done" }
  ] },
  "expect": [
    { "type": "invoke", "name": "b.done", "result": { "data": { "ok": true } } },
    { "type": "invoke", "name": "b.edit", "result": { "data": { "count": 1 } } },
    { "type": "invoke", "name": "b.edit", "result": { "data": { "count": 2 } } }
  ],
  "absent": [{ "type": "invoke", "name": "b.edit", "error": { "$any": true } }]
}
